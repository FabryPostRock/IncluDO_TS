{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TypeScript: Debug file corrente in WSL",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "restart": false,
      "preLaunchTask": "TypeScript: Avvia file corrente per debugger",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "TypeScript: Debug applicazione compilata",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9230,
      "restart": false,
      "preLaunchTask": "TypeScript: Avvia applicazione compilata per debugger",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Node: Collega debugger alla porta 9229",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
