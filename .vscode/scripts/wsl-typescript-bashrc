# Profilo Bash dedicato al terminale integrato del workspace TypeScript in WSL.

# Carica prima la configurazione Bash personale, se esiste.
if [[ -f "$HOME/.bashrc" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.bashrc"
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck source=/dev/null
  source "$NVM_DIR/nvm.sh"
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/../.." && pwd)"

cd "$PROJECT_DIR" || return 1

if command -v nvm >/dev/null 2>&1; then
  if [[ -f "$PROJECT_DIR/.nvmrc" ]]; then
    nvm use --silent >/dev/null 2>&1 || {
      printf '%s\n' "Node richiesto da .nvmrc non è installato. Esegui il task: Node Setup: Installa Node in WSL."
    }
  else
    nvm use --silent default >/dev/null 2>&1 || true
  fi
elif command -v node >/dev/null 2>&1 && [[ "$(node -p 'process.platform' 2>/dev/null)" == "linux" ]]; then
  printf 'NVM non presente; uso Node Linux già disponibile: %s\n' "$(node --version)"
else
  printf '%s\n' "Node non trovato in WSL. Esegui il task: Node Setup: Installa Node in WSL."
fi
